{
  "name": "cert-manager",
  "version": "1.0.0",
  "description": "Certificate and CA Manager for gRPC mutual TLS",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "node --import tsx --watch src/index.ts",
    "test": "jest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.18.2",
    "log4js": "^6.9.1",
    "node-forge": "^1.3.3",
    "node-schedule": "^2.1.1",
    "uuid": "^9.0.1",
    "yaml": "^2.3.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.3.3",
    "@types/node-forge": "^1.3.14",
    "@types/node-schedule": "^2.1.8",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "bun-types": "^1.0.0",
    "jest": "^30.3.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
