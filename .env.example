# Environment Variables for cert-manager
# Copy this file to .env and customize for your environment
# DO NOT commit .env to version control!

# ============================================
# Server Configuration
# ============================================

# API Key for cert-manager authentication (required)
# Generate with: openssl rand -hex 32
API_KEY=your-secure-api-key-min-32-characters-here

# Server Host (optional, defaults to 0.0.0.0)
# SERVER_HOST=0.0.0.0

# Server Port (optional, defaults to 3111)
# SERVER_PORT=3111

# ============================================
# CA Server Configuration
# ============================================

# CA Server URL (must use HTTPS in production)
CA_SERVER_URL=https://your-ca-server.example.com

# API Key for CA Server authentication
CA_API_KEY=your-ca-server-api-key

# PFX Decryption Password
PFX_PASSWORD=your-pfx-decryption-password

# CA Server Timeout in milliseconds (optional, defaults to 30000)
# CA_TIMEOUT=30000

# ============================================
# Storage Configuration
# ============================================

# Storage Base Path (optional, defaults to /var/lib/cert-manager)
# STORAGE_BASE_PATH=/var/lib/cert-manager

# Certificates Directory (optional, defaults to certs)
# STORAGE_CERTS_DIR=certs

# Metadata Directory (optional, defaults to metadata)
# STORAGE_METADATA_DIR=metadata

# ============================================
# Logging Configuration
# ============================================

# Log Level: debug, info, warn, error (optional, defaults to info)
# LOGGING_LEVEL=info

# ============================================
# Node Environment
# ============================================

# Node Environment: development or production
NODE_ENV=production
